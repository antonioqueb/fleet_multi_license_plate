<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_fleet_safety_equipment" model="ir.actions.act_window">
        <field name="name">EPP, Extintores y Kits de Derrames</field>
        <field name="res_model">fleet.safety.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_vehicle': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Registre el equipo de protección personal, extintores y kits de
                derrames asignados a cada vehículo, con su fecha de
                vencimiento o recarga.
            </p>
        </field>
    </record>

    <record id="view_fleet_safety_equipment_list" model="ir.ui.view">
        <field name="name">fleet.safety.equipment.list</field>
        <field name="model">fleet.safety.equipment</field>
        <field name="arch" type="xml">
            <list default_order="vehicle_id, expiration_date" decoration-danger="state == 'expired'" decoration-warning="state == 'warning'">
                <field name="vehicle_id"/>
                <field name="equipment_type"/>
                <field name="name"/>
                <field name="quantity" optional="show"/>
                <field name="capacity" optional="hide"/>
                <field name="last_inspection_date" optional="show"/>
                <field name="expiration_date"/>
                <field name="responsible_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'ok'"
                       decoration-info="state == 'sin_vencimiento'"
                       decoration-warning="state == 'warning'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_safety_equipment_form" model="ir.ui.view">
        <field name="name">fleet.safety.equipment.form</field>
        <field name="model">fleet.safety.equipment</field>
        <field name="arch" type="xml">
            <form string="EPP / Extintor / Kit de Derrames">
                <sheet>
                    <widget name="web_ribbon" title="Vencido" bg_color="text-bg-danger" invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Próximo a Vencer" bg_color="text-bg-warning" invisible="state != 'warning'"/>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej: Extintor PQS 9kg"/></h1>
                    </div>
                    <group>
                        <group string="Equipo">
                            <field name="vehicle_id" options="{'no_create': True}"/>
                            <field name="equipment_type"/>
                            <field name="quantity"/>
                            <field name="capacity"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Vigencia">
                            <field name="last_inspection_date"/>
                            <field name="expiration_date"/>
                            <field name="responsible_id"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fleet_safety_equipment_search" model="ir.ui.view">
        <field name="name">fleet.safety.equipment.search</field>
        <field name="model">fleet.safety.equipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="equipment_type"/>
                <filter string="Vencidos" name="filter_expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Próximos a Vencer" name="filter_warning" domain="[('state', '=', 'warning')]"/>
                <filter string="Vigentes" name="filter_ok" domain="[('state', '=', 'ok')]"/>
                <separator/>
                <filter string="EPP" name="filter_epp" domain="[('equipment_type', '=', 'epp')]"/>
                <filter string="Extintores" name="filter_extintor" domain="[('equipment_type', '=', 'extintor')]"/>
                <filter string="Kits de Derrames" name="filter_kit" domain="[('equipment_type', '=', 'kit_derrames')]"/>
                <separator/>
                <filter string="Vehículo" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                <filter string="Tipo" name="group_type" context="{'group_by': 'equipment_type'}"/>
                <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_fleet_vehicle_form_safety_equipment" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.safety.equipment</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_safety_equipment" type="object" class="oe_stat_button" icon="fa-fire-extinguisher">
                    <field name="safety_equipment_count" widget="statinfo" string="EPP/Extintores/Kits"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="EPP, Extintores y Kits de Derrames" name="safety_equipment">
                    <div class="alert alert-danger" role="alert" invisible="safety_equipment_alert_count == 0">
                        ⚠️ Hay <field name="safety_equipment_alert_count" nolabel="1" class="oe_inline"/> elemento(s)
                        vencido(s) o próximo(s) a vencer.
                    </div>
                    <field name="safety_equipment_ids">
                        <list editable="bottom" decoration-danger="state == 'expired'" decoration-warning="state == 'warning'">
                            <field name="equipment_type"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="capacity" optional="hide"/>
                            <field name="last_inspection_date"/>
                            <field name="expiration_date"/>
                            <field name="responsible_id" optional="hide"/>
                            <field name="state" widget="badge" readonly="1"
                                   decoration-success="state == 'ok'"
                                   decoration-info="state == 'sin_vencimiento'"
                                   decoration-warning="state == 'warning'"
                                   decoration-danger="state == 'expired'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_fleet_safety_equipment_root"
              name="Seguridad de Flota"
              sequence="80"/>

    <menuitem id="menu_fleet_safety_equipment"
              name="EPP, Extintores y Kits de Derrames"
              parent="menu_fleet_safety_equipment_root"
              action="action_fleet_safety_equipment"
              sequence="10"/>

</odoo>
