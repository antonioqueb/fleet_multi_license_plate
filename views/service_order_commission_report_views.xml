<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_order_driver_commission_list" model="ir.ui.view">
        <field name="name">service.order.driver.commission.list</field>
        <field name="model">service.order</field>
        <field name="arch" type="xml">
            <list string="Servicios por Chofer" default_order="date_order desc" create="false">
                <field name="name"/>
                <field name="chofer_id"/>
                <field name="date_order"/>
                <field name="partner_id" string="Cliente"/>
                <field name="state" widget="badge"/>
                <field name="invoicing_status" widget="badge" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="driver_commission_percentage" string="% Comisión" widget="percentage" optional="show"/>
                <field name="driver_commission_amount" widget="monetary" string="Comisión" sum="Total Comisión"/>
            </list>
        </field>
    </record>

    <record id="view_service_order_driver_commission_pivot" model="ir.ui.view">
        <field name="name">service.order.driver.commission.pivot</field>
        <field name="model">service.order</field>
        <field name="arch" type="xml">
            <pivot string="Comisiones por Chofer">
                <field name="chofer_id" type="row"/>
                <field name="date_order" interval="month" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="driver_commission_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_service_order_driver_commission_graph" model="ir.ui.view">
        <field name="name">service.order.driver.commission.graph</field>
        <field name="model">service.order</field>
        <field name="arch" type="xml">
            <graph string="Comisiones por Chofer" type="bar">
                <field name="chofer_id"/>
                <field name="driver_commission_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_service_order_driver_commission_search" model="ir.ui.view">
        <field name="name">service.order.driver.commission.search</field>
        <field name="model">service.order</field>
        <field name="arch" type="xml">
            <search string="Servicios por Chofer">
                <field name="chofer_id"/>
                <field name="partner_id"/>
                <field name="name"/>
                <filter string="Completadas" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Facturadas" name="filter_invoiced" domain="[('invoicing_status', 'in', ('invoiced', 'paid'))]"/>
                <separator/>
                <filter string="Este Mes" name="filter_month"
                        domain="[('date_order', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Chofer" name="group_chofer" context="{'group_by': 'chofer_id'}"/>
                <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Mes" name="group_month" context="{'group_by': 'date_order:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_service_order_driver_commission_report" model="ir.actions.act_window">
        <field name="name">Reporte de Servicios por Chofer</field>
        <field name="res_model">service.order</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[('chofer_id', '!=', False)]</field>
        <field name="context">{'search_default_group_chofer': 1}</field>
        <field name="search_view_id" ref="view_service_order_driver_commission_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Órdenes de Servicio con chofer asignado, con el porcentaje y
                monto de comisión calculados — listo para exportar y
                liquidar comisiones externas.
            </p>
        </field>
    </record>

    <record id="action_service_order_driver_commission_report_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_service_order_driver_commission_list"/>
        <field name="act_window_id" ref="action_service_order_driver_commission_report"/>
    </record>

    <record id="action_service_order_driver_commission_report_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_service_order_driver_commission_pivot"/>
        <field name="act_window_id" ref="action_service_order_driver_commission_report"/>
    </record>

    <record id="action_service_order_driver_commission_report_view_graph" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_service_order_driver_commission_graph"/>
        <field name="act_window_id" ref="action_service_order_driver_commission_report"/>
    </record>

</odoo>
