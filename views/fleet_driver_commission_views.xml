<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_fleet_driver_commission" model="ir.actions.act_window">
        <field name="name">Comisiones por Chofer</field>
        <field name="res_model">fleet.driver.commission</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Defina el porcentaje de comisión vigente de cada chofer sobre
                sus Órdenes de Servicio. Solo puede haber una comisión activa
                por chofer a la vez.
            </p>
        </field>
    </record>

    <record id="view_fleet_driver_commission_list" model="ir.ui.view">
        <field name="name">fleet.driver.commission.list</field>
        <field name="model">fleet.driver.commission</field>
        <field name="arch" type="xml">
            <list default_order="driver_id, date_from desc">
                <field name="driver_id"/>
                <field name="percentage" widget="percentage"/>
                <field name="date_from"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_driver_commission_form" model="ir.ui.view">
        <field name="name">fleet.driver.commission.form</field>
        <field name="model">fleet.driver.commission</field>
        <field name="arch" type="xml">
            <form string="Comisión de Chofer">
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="driver_id" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="percentage"/>
                            <field name="date_from"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fleet_driver_commission_search" model="ir.ui.view">
        <field name="name">fleet.driver.commission.search</field>
        <field name="model">fleet.driver.commission</field>
        <field name="arch" type="xml">
            <search>
                <field name="driver_id"/>
                <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

</odoo>
